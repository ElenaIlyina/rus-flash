    {
      "id": "B5A555",
      "options": [
        {
          "number": 1,
          "word": "лицо",
          "articleHeadword": "лицо",
          "keySelects": false,
          "reason": "Лица — люди, участники движения. Передняя часть головы не имеется в виду."
        },
        {
          "number": 2,
          "word": "край",
          "articleHeadword": "край",
          "keySelects": true,
          "reason": "Край проезжей части — её граница, предельная часть. Значение соответствует правилу движения."
        },
        {
          "number": 3,
          "word": "средство",
          "articleHeadword": "средство",
          "keySelects": false,
          "reason": "Транспортные средства — машины и другие средства передвижения. Это не абстрактный приём достижения цели."
        },
        {
          "number": 4,
          "word": "следовать",
          "articleHeadword": "следовать",
          "keySelects": true,
          "reason": "Следовать по ходу движения — двигаться в данном направлении. Значение движения подходит."
        },
        {
          "number": 5,
          "word": "элемент",
          "articleHeadword": "элемент",
          "keySelects": false,
          "reason": "В ключе вариант не выбран: в контексте названы отдельные светоотражающие детали предметов. Формулировка о доле в составе чего-либо близка по общему смыслу, поэтому не следует выводить отсюда запрет называть физическую деталь элементом. Для выбора ответа в этом упражнении сохраняется ключ."
        }
      ],

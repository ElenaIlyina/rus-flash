    {
      "id": "F5E433",
      "options": [
        {
          "number": 1,
          "word": "стиль",
          "articleHeadword": "стиль",
          "keySelects": true,
          "reason": "Стиль характеризует художественную манеру и содержание искусства. Это соответствует определению индивидуального художественного целого."
        },
        {
          "number": 2,
          "word": "опыт",
          "articleHeadword": "опыт",
          "keySelects": false,
          "reason": "Жизненный опыт — накопленные знания и навыки человека. Эксперимент в заданных условиях не проводится."
        },
        {
          "number": 3,
          "word": "прямой",
          "articleHeadword": "прямой",
          "keySelects": true,
          "reason": "Прямое уродство — явное, несомненное уродство. Слово не обозначает геометрическую прямизну."
        },
        {
          "number": 4,
          "word": "ловить",
          "articleHeadword": "ловить",
          "keySelects": true,
          "reason": "Ловить музыку из эфира — принимать радиопередачу, настраивая приёмник. Это не поимка движущегося предмета."
        },
        {
          "number": 5,
          "word": "сила",
          "articleHeadword": "сила",
          "keySelects": false,
          "reason": "Свежие силы — новые люди, способные работать и творить. Военные подразделения не имеются в виду."
        }
      ],

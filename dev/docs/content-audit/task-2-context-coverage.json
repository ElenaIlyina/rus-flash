    {
      "id": "CD2CCE",
      "options": [
        {
          "number": 1,
          "word": "обычай",
          "articleHeadword": "обычай",
          "keySelects": true,
          "reason": "Обычай — установившееся правило посылать помощь арестованным по праздникам. Значение соответствует описанному общественному поведению."
        },
        {
          "number": 2,
          "word": "послать",
          "articleHeadword": "послать",
          "keySelects": false,
          "reason": "В тюрьмы посылали реальные продукты. Это не передача привета, поклона или отношения жестом."
        },
        {
          "number": 3,
          "word": "свежий",
          "articleHeadword": "свежий",
          "keySelects": false,
          "reason": "Свежие калачи — недавно испечённые, не чёрствые. Яркость красок или воспоминаний — другое значение."
        },
        {
          "number": 4,
          "word": "отличие",
          "articleHeadword": "отличие",
          "keySelects": true,
          "reason": "Ключ включает этот вариант. Однако «медальные и мундирные отличия» в контексте связаны с наградами и внешними знаками поощрения. Словарь отдельно выделяет такое употребление и отличает его от общего «признака различия». Не нужно заучивать, будто эти два толкования во всех случаях совпадают; проверка данного упражнения следует ключу."
        },
        {
          "number": 5,
          "word": "горячий",
          "articleHeadword": "горячий",
          "keySelects": false,
          "reason": "Горячие калачи имеют высокую температуру. Вспыльчивый характер человека — переносное значение, не соответствующее контексту."
        }
      ],

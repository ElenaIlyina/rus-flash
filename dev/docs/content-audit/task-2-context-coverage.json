        "ухаживать"
      ]
    },
    {
      "id": "5A83DF",
      "options": [
        {
          "number": 1,
          "word": "содержание",
          "articleHeadword": "содержание",
          "keySelects": false,
          "reason": "Содержание речи — то, о чём говорится. Заработная плата к этому контексту отношения не имеет."
        },
        {
          "number": 2,
          "word": "элемент",
          "articleHeadword": "элемент",
          "keySelects": true,
          "reason": "Чужое высказывание входит в речь как конструктивная часть целого. Это значение компонента."
        },
        {
          "number": 3,
          "word": "ввести",
          "articleHeadword": "ввести",
          "keySelects": false,
          "reason": "«Ввести его в конструкцию речи» — включить высказывание в состав другого. Это не установление новых порядков."
        },
        {
          "number": 4,
          "word": "вырабатывать",
          "articleHeadword": "выработать",
          "keySelects": false,
          "reason": "Авторское высказывание создаёт нормы включения чужой речи. Изготовление материальной продукции — другое значение."
        },
        {
          "number": 5,
          "word": "первичный",
          "articleHeadword": "первичный",
          "keySelects": true,
          "reason": "«Первичную самостоятельность» — исходную самостоятельность чужого высказывания до его включения в авторское."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "86ac15e907780e023c73ed9af0375ef5850d9051c99b0df017ca03a6dac1275c",
      "headwords": [
        "содержание",
        "элемент",
        "ввести",
        "выработать",
        "первичный"
      ]
    },
    {
      "id": "62A8A9",
      "options": [
        {
          "number": 1,
          "word": "осветить",
          "articleHeadword": "осветить",
          "keySelects": false,
          "reason": "«Осветить по-новому явление» — объяснить, истолковать его. Направлять лучи света на предмет не требуется."
        },
        {
          "number": 2,
          "word": "масса",
          "articleHeadword": "масса",
          "keySelects": false,
          "reason": "«Массой описаний» — множеством описаний, а не физической массой вещества."
        },
        {
          "number": 3,
          "word": "чужой",
          "articleHeadword": "чужой",
          "keySelects": false,
          "reason": "Чужие высказывания принадлежат другому говорящему. Они не обязательно далеки автору по духу или взглядам."
        },
        {
          "number": 4,
          "word": "взгляд",
          "articleHeadword": "взгляд",
          "keySelects": true,
          "reason": "«На поверхностный взгляд» — по поверхностному суждению, мнению. Это переносное значение, не направление зрения."
        },
        {
          "number": 5,
          "word": "вопрос",
          "articleHeadword": "вопрос",
          "keySelects": true,
          "reason": "«Вопросе синтаксиса» — предмете исследования, проблеме, а не вопросительной реплике собеседника."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "fdf9185a3dd4a25d8348b6dfc08d8c282b011101c237a296943d66254bcb0ae5",
      "headwords": [
        "осветить",
        "масса",
        "чужой",
        "взгляд",
        "вопрос"
      ]
    },
    {
      "id": "7AB7D7",
      "options": [
        {
          "number": 1,
          "word": "земля",
          "articleHeadword": "земля",
          "keySelects": false,
          "reason": "«По русской земле» — по территории, стране. Имеется в виду не Земля как планета."
        },
        {
          "number": 2,
          "word": "собирать",
          "articleHeadword": "собрать",
          "keySelects": false,
          "reason": "Осень собирает грибы, то есть подбирает их в подол. Созывание людей в одно место — другое значение."
        },
        {
          "number": 3,
          "word": "разводить",
          "articleHeadword": "разводить",
          "keySelects": true,
          "reason": "Разводит хвойные лапы в стороны — раздвигает соединённые части. Значение подходит и при олицетворении осени."
        },
        {
          "number": 4,
          "word": "верста",
          "articleHeadword": "верста",
          "keySelects": false,
          "reason": "«На тысячи вёрст» обозначает расстояние. Это мера длины, а не дорожный столб."
        },
        {
          "number": 5,
          "word": "шум",
          "articleHeadword": "шум",
          "keySelects": true,
          "reason": "Шум тайги — слившееся звучание ветра и деревьев. Это акустическое значение."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "de509421e04d589267b338d545e477bac3eca41d4c61ada79db36c059d958691",
      "headwords": [
        "земля",

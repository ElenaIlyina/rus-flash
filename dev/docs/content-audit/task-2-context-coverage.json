      "options": [
        {
          "number": 1,
          "word": "сокращение",
          "articleHeadword": "сокращение",
          "keySelects": false,
          "reason": "Сокращение площади льдов — уменьшение площади. Пропуск фрагмента текста — другое значение."
        },
        {
          "number": 2,
          "word": "режим",
          "articleHeadword": "режим",
          "keySelects": false,
          "reason": "Режим осадков — закономерность и условия их выпадения. Распорядок повседневной жизни человека здесь не обсуждается."
        },
        {
          "number": 3,
          "word": "масштабный",
          "articleHeadword": "масштабный",
          "keySelects": true,
          "reason": "Масштабные пожары имеют большой охват. Значение соответствует размерам явления."
        },
        {
          "number": 4,
          "word": "считаться",
          "articleHeadword": "считаться",
          "keySelects": true,
          "reason": "Факторы считаются основными — признаются, расцениваются как основные. Это не числовой подсчёт."
        },
        {
          "number": 5,
          "word": "оценка",
          "articleHeadword": "оценка",
          "keySelects": false,
          "reason": "Оценка парникового эффекта — установление его величины и значения. Школьная отметка за знания не имеется в виду."
        }
      ],

    {
      "id": "E96B4A",
      "options": [
        {
          "number": 1,
          "word": "готовый",
          "articleHeadword": "готовый",
          "keySelects": true,
          "reason": "Готовые языковые формулы — уже сложившиеся, воспроизводимые выражения. Это не готовность человека уехать или помочь; точная формулировка данного толкования требует дополнительного словарного источника."
        },
        {
          "number": 2,
          "word": "оценивать",
          "articleHeadword": "оценить",
          "keySelects": false,
          "reason": "Оценивать информацию — высказывать суждение о её значении и качестве. Денежная цена не определяется."
        },
        {
          "number": 3,
          "word": "ход",
          "articleHeadword": "ход",
          "keySelects": false,
          "reason": "Ход мысли — её развитие и последовательность. Торжественное шествие или процессия не имеется в виду."
        },
        {
          "number": 4,
          "word": "сфера",
          "articleHeadword": "сфера",
          "keySelects": true,
          "reason": "Социально-бытовая сфера — среда общения людей. Это не геометрическая поверхность шара."
        },
        {
          "number": 5,
          "word": "свободный",
          "articleHeadword": "свободный",
          "keySelects": false,
          "reason": "Свободная беседа — непринуждённая, не связанная жёсткими рамками. Свободное место или незанятый телефон — другое значение."
        }
      ],

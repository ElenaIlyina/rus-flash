  "cards": [
    {
      "id": "082CB8",
      "options": [
        {
          "number": 1,
          "word": "печатать",
          "articleHeadword": "печатать",
          "keySelects": true,
          "reason": "Героиня три часа набирала текст на пишущей машинке; это воспроизведение текста с помощью аппарата."
        },
        {
          "number": 2,
          "word": "работа",
          "articleHeadword": "работа",
          "keySelects": false,
          "reason": "«Работы — непочатый край» означает много предстоящих дел. Качество исполнения вещи здесь не оценивается."
        },
        {
          "number": 3,
          "word": "опомниться",
          "articleHeadword": "опомниться",
          "keySelects": true,
          "reason": "«Опомнилась — хочется упущенное наверстать» означает переосмыслила прежнее поведение. Это не возвращение в сознание после обморока."
        },
        {
          "number": 4,
          "word": "поступать",
          "articleHeadword": "поступить",
          "keySelects": false,
          "reason": "Олег собирается зачислиться на физический факультет. Прибытие заявлений или книг по назначению — другое значение."
        },
        {
          "number": 5,
          "word": "потерять",
          "articleHeadword": "терять",
          "keySelects": true,
          "reason": "«Столько времени потеряла» означает нецелесообразно потратила годы. Речь не о потере предмета."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,

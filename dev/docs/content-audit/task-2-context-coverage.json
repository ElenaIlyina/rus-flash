    {
      "id": "0ABFEC",
      "options": [
        {
          "number": 1,
          "word": "прямой",
          "articleHeadword": "прямой",
          "keySelects": false,
          "reason": "Прямое действие нормы — непосредственное действие. Это не откровенность или нелицемерность человека."
        },
        {
          "number": 2,
          "word": "акт",
          "articleHeadword": "акт",
          "keySelects": false,
          "reason": "Названы законы и другие правовые документы. Акт в значении части спектакля к ним не относится."
        },
        {
          "number": 3,
          "word": "норма",
          "articleHeadword": "норма",
          "keySelects": true,
          "reason": "Нормы международного права — обязательные установления и правила. Значение соответствует правовому контексту."
        },
        {
          "number": 4,
          "word": "система",
          "articleHeadword": "система",
          "keySelects": false,
          "reason": "Правовая система — связанное целое норм и институтов. Это не техническое устройство или конструкция самолёта."
        },
        {
          "number": 5,
          "word": "установить",
          "articleHeadword": "установить",
          "keySelects": true,
          "reason": "Договор устанавливает правила, то есть вводит их в действие. Значение не связано с монтажом предмета."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "0429b810c82a41887e79f1138f120ce77655a1d2c15a8dc27d7496c413061d9c",
      "headwords": [
        "прямой",
        "акт",
        "норма",
        "система",
        "установить"
      ]
    },
    {
      "id": "2BA3EC",
      "options": [
        {
          "number": 1,
          "word": "эпиграф",
          "articleHeadword": "эпиграф",
          "keySelects": true,
          "reason": "Перед рассказом приведены строки из «Апокалипсиса», задающие мотив гибели. Это изречение перед произведением."
        },
        {
          "number": 2,
          "word": "звучать",
          "articleHeadword": "звучать",
          "keySelects": false,
          "reason": "Мотив смерти «звучит» в рассказе в переносном смысле: проявляется, выражается. Физического звучания струн нет."
        },
        {
          "number": 3,
          "word": "масса",
          "articleHeadword": "масса",
          "keySelects": false,
          "reason": "«Масса деталей» — большое количество подробностей. Физическая величина массы здесь не измеряется."
        },
        {
          "number": 4,
          "word": "наследный",
          "articleHeadword": "наследовать",
          "keySelects": true,
          "reason": "«Наследный принц» — принц, являющийся наследником престола. Это сочетание прямо дано в статье «наследовать»."
        },
        {
          "number": 5,
          "word": "инкогнито",
          "articleHeadword": "инкогнито",
          "keySelects": true,
          "reason": "Путешествовать инкогнито — не раскрывать своего имени. Значение соответствует описанию поездки принца."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "7e139652c39a6e3807dbd844147b00b032c6ddf7d609bed19e015380496b1f03",
      "headwords": [

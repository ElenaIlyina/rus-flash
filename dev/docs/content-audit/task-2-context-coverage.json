    {
      "id": "883E90",
      "options": [
        {
          "number": 1,
          "word": "хаос",
          "articleHeadword": "хаос",
          "keySelects": true,
          "reason": "Каменный хаос — беспорядочное нагромождение камней. Это не специальное мифологическое значение первоматерии."
        },
        {
          "number": 2,
          "word": "порог",
          "articleHeadword": "порог",
          "keySelects": false,
          "reason": "Речной порог — каменистый участок русла с быстрым течением, а не брусок дверного проёма."
        },
        {
          "number": 3,
          "word": "увал",
          "articleHeadword": "увал",
          "keySelects": true,
          "reason": "Увалы — пологие вытянутые возвышенности. Определение соответствует описанию рельефа."
        },
        {
          "number": 4,
          "word": "полый",
          "articleHeadword": "полый",
          "keySelects": true,
          "reason": "«В полую воду» — во время весеннего разлива. Здесь не значение «пустой внутри»."
        },
        {
          "number": 5,
          "word": "древесный",
          "articleHeadword": "древесный",
          "keySelects": false,
          "reason": "Древесные скелеты — остатки самих деревьев. Это не материал, полученный переработкой древесины, как древесный уголь."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "ac15037fadd48fcaec7387c12d91cb8317cfb1cb37bde7c08d02954bdadc92c4",
      "headwords": [

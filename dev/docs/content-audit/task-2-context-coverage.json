    {
      "id": "33BA3C",
      "options": [
        {
          "number": 1,
          "word": "эталон",
          "articleHeadword": "эталон",
          "keySelects": true,
          "reason": "Кумиры служат образцами поведения, на которые равняются. Это переносное значение «эталон», не единица измерения."
        },
        {
          "number": 2,
          "word": "культура",
          "articleHeadword": "культура",
          "keySelects": false,
          "reason": "Названы вечные духовные и общественные ценности культуры. Разведение растений или животных не имеется в виду."
        },
        {
          "number": 3,
          "word": "веяние",
          "articleHeadword": "веяние",
          "keySelects": true,
          "reason": "Новые веяния — изменения тенденций в искусстве и общественных настроениях. Это не движение воздуха."
        },
        {
          "number": 4,
          "word": "элемент",
          "articleHeadword": "элемент",
          "keySelects": false,
          "reason": "Недостатки названы частью личности и таланта, а не химическим веществом. Нужно значение компонента целого."
        },
        {
          "number": 5,
          "word": "уход",
          "articleHeadword": "уход",
          "keySelects": false,
          "reason": "«После его ухода» в данном контексте означает после смерти кумира. Забота о больном или растениях — другое слово-омоним."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",
      "exactDefinitionSourcePending": false,
      "sourceContentSha256": "9979e9ad8f4aef411a2dbb6f7cc58794b08c211f48e2d540c96acd1010c4ae0f",
      "headwords": [
        "эталон",

    {
      "id": "9273A5",
      "options": [
        {
          "number": 1,
          "word": "фундамент",
          "articleHeadword": "фундамент",
          "keySelects": false,
          "reason": "Башня из облаков опускается на своё основание. Отвлечённый фундамент науки или развития не имеется в виду."
        },
        {
          "number": 2,
          "word": "ползти",
          "articleHeadword": "ползти",
          "keySelects": true,
          "reason": "Узоры облаков медленно движутся. Переносное движение неживых предметов соответствует указанному значению."
        },
        {
          "number": 3,
          "word": "образ",
          "articleHeadword": "образ",
          "keySelects": false,
          "reason": "«Пленительные образы» — возникающие в воображении видения. Это не персонажи или обобщённые человеческие типы художественного произведения."
        },
        {
          "number": 4,
          "word": "храм",
          "articleHeadword": "храм",
          "keySelects": true,
          "reason": "Облачные сооружения сравниваются с освещённым храмом. Само слово в сравнении сохраняет значение культового здания."
        },
        {
          "number": 5,
          "word": "жизнь",
          "articleHeadword": "жизнь",
          "keySelects": false,
          "reason": "Жизнь сравнивается с покойной природой. Её стоимость и материальное обеспечение не обсуждаются."
        }
      ],
      "highlightCount": 5,

    {
      "id": "9819CF",
      "options": [
        {
          "number": 1,
          "word": "характеристика",
          "articleHeadword": "характеристика",
          "keySelects": false,
          "reason": "Ритмико-интонационные характеристики — свойства звучания. Официальный отзыв с места работы не имеется в виду."
        },
        {
          "number": 2,
          "word": "тип",
          "articleHeadword": "тип",
          "keySelects": true,
          "reason": "Типы ударения — разновидности с определёнными признаками. Это соответствует предложенному толкованию."
        },
        {
          "number": 3,
          "word": "позиция",
          "articleHeadword": "позиция",
          "keySelects": true,
          "reason": "Позиция слова — его положение в интонационной структуре. Это не точка зрения или принципиальная установка."
        },
        {
          "number": 4,
          "word": "общий",
          "articleHeadword": "общий",
          "keySelects": false,
          "reason": "Общие тенденции — общие закономерности изменения звучания. Здесь не совместное использование вещи или совместный труд."
        },
        {
          "number": 5,
          "word": "выступать",
          "articleHeadword": "выступать",
          "keySelects": false,
          "reason": "«На первый план выступают параметры» — становятся заметными, выдвигаются. Параметры не произносят публичную речь."
        }
      ],
      "highlightCount": 5,

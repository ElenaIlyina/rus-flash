    {
      "id": "BCF56B",
      "options": [
        {
          "number": 1,
          "word": "жизнь",
          "articleHeadword": "жизнь",
          "keySelects": false,
          "reason": "«Проверялось жизнью» — проверялось практикой, действительным опытом. Биологическая форма существования материи — другое значение."
        },
        {
          "number": 2,
          "word": "типовой",
          "articleHeadword": "типовой",
          "keySelects": true,
          "reason": "Типовые дома соответствуют образцу, стандарту. Значение дано верно."
        },
        {
          "number": 3,
          "word": "проект",
          "articleHeadword": "проект",
          "keySelects": false,
          "reason": "Проекты домов — планы строительства, а не предварительные тексты резолюций или других документов."
        },
        {
          "number": 4,
          "word": "скромный",
          "articleHeadword": "скромный",
          "keySelects": false,
          "reason": "Скромные особнячки — небольшие, небогатые внешне. Здание не может хвастаться своими заслугами, как человек."
        },
        {
          "number": 5,
          "word": "повторять",
          "articleHeadword": "повторить",
          "keySelects": true,
          "reason": "Повторяли размеры и пропорции — воспроизводили существующий образец. Контекст даёт значение копирования; точная формулировка этого толкования в полученной копии словаря не напечатана."
        }
      ],

    {
      "id": "E9174D",
      "options": [
        {
          "number": 1,
          "word": "прийти",
          "articleHeadword": "прийти",
          "keySelects": false,
          "reason": "«Пришёл праздник» означает наступил. Усилия ради достижения соглашения или результата — другое значение."
        },
        {
          "number": 2,
          "word": "духовный",
          "articleHeadword": "духовный",
          "keySelects": false,
          "reason": "Духовная сущность — нравственная и культурная основа, а не принадлежность к церкви или религиозному обряду."
        },
        {
          "number": 3,
          "word": "характер",
          "articleHeadword": "характер",
          "keySelects": false,
          "reason": "Национальный характер — совокупность особенностей народа. Это не личная твёрдость воли и упорство."
        },
        {
          "number": 4,
          "word": "прозрение",
          "articleHeadword": "прозрение",
          "keySelects": true,
          "reason": "Прозрение — внезапное понимание, проникновение мыслью в скрытое. Речь о поэтическом предвидении, а не о буквальном возвращении зрения."
        },
        {
          "number": 5,
          "word": "кровь",
          "articleHeadword": "кровь",
          "keySelects": true,
          "reason": "Испанская кровь указывает на переживаемую героем национальную принадлежность. Это переносное значение происхождения, не физиологическая жидкость."
        }
      ],
      "highlightCount": 5,
      "highlightRestorationPending": false,
      "contextAssessment": "context_supported",

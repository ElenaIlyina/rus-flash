    {
      "id": "E29F76",
      "options": [
        {
          "number": 1,
          "word": "длина",
          "articleHeadword": "длина",
          "keySelects": true,
          "reason": "Длина фразы — её протяжённость. Это не продолжительность жизни или иное отвлечённое значение."
        },
        {
          "number": 2,
          "word": "расположение",
          "articleHeadword": "расположение",
          "keySelects": false,
          "reason": "Расположение слов — порядок их размещения в фразе. Симпатия к кому-либо не имеется в виду."
        },
        {
          "number": 3,
          "word": "художественный",
          "articleHeadword": "художественный",
          "keySelects": true,
          "reason": "Художественный текст изображает действительность в образах. Это соответствует литературе как искусству."
        },
        {
          "number": 4,
          "word": "представление",
          "articleHeadword": "представление",
          "keySelects": false,
          "reason": "Представление о своеобразии — знание, понимание особенностей. Театральный спектакль здесь не имеется в виду."
        },
        {
          "number": 5,
          "word": "живой",
          "articleHeadword": "живой",
          "keySelects": false,
          "reason": "Живые интонации — выразительные, естественные интонации звучащей речи. Биологическим существом интонация не является."
        }
      ],
